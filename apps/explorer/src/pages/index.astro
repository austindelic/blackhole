---
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <div class="project-page">
    <section class="project-intro" aria-labelledby="project-title">
      <div><h1 id="project-title">Blackhole</h1><p class="lede">An ASCII black hole renderer for the web and terminal.</p></div>
      <a class="author" href="https://austindelic.com">By Austin Delic</a>
    </section>
    <figure class="render-preview">
      <img src="/images/blackhole-preview.webp" alt="Amber ASCII accretion disk and lensed stars around a black hole" width="1512" height="951" fetchpriority="high" />
      <figcaption><span>Home camera · ASCII</span><a class="button primary" href="/explore/">Open explorer <span aria-hidden="true">↗</span></a></figcaption>
    </figure>
    <section class="quick-start" aria-labelledby="install-title">
      <h2 id="install-title">Use it</h2>
      <div class="install-options">
        <div><h3>Web</h3><pre><code>npm install @austindelic/blackhole</code></pre><a href="/docs/">React and canvas API →</a></div>
        <div><h3>Terminal</h3><pre><code>npx @austindelic/blackhole-cli explore</code></pre><div class="guide-links"><a href="/docs/terminal/#rust">Rust / Ratatui →</a><a href="/docs/terminal/#ghostty">Ghostty →</a></div></div>
      </div>
    </section>
    <p class="project-note">Extracted from <a href="https://github.com/austindelic/portfolio">my portfolio</a>. The shaders, browser library, and Rust crates are in <a href="https://github.com/austindelic/blackhole">the repository</a>.</p>
  </div>
</Layout>
