---
import '../styles/global.css';
const { title = 'Blackhole | Austin Delic', description = 'An ASCII black hole renderer for the web and terminal. By Austin Delic.', immersive = false } = Astro.props;
const source = 'https://github.com/austindelic/blackhole';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#080807" /><meta name="description" content={description} />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} />
  <meta property="og:type" content="website" /><meta property="og:url" content={new URL(Astro.url.pathname, 'https://blackhole.austindelic.com')} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta property="og:image" content="https://blackhole.austindelic.com/images/blackhole-preview.webp" />
  <link rel="canonical" href={new URL(Astro.url.pathname, 'https://blackhole.austindelic.com')} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
</head>
<body class:list={[{ immersive }]}>
  <a class="skip" href="#main">Skip to content</a>
  <header class="header">
    <a class="wordmark" href="/" aria-label="Blackhole home">Blackhole</a>
    <nav aria-label="Main navigation"><a href="/explore/" aria-current={Astro.url.pathname.startsWith('/explore') ? 'page' : undefined}>Explorer</a><a href="/docs/" aria-current={Astro.url.pathname.startsWith('/docs') ? 'page' : undefined}>Docs</a><a href={source}>GitHub</a></nav>
  </header>
  <main id="main"><slot /></main>
  {!immersive && <footer class="footer"><a href="https://austindelic.com">Austin Delic</a><div><a href="/docs/architecture/">Credits</a><a href={`${source}/blob/main/LICENSE`}>GPL-3.0</a><a href={source}>Source</a></div></footer>}
</body>
</html>
